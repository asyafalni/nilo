.{
    .name = .nilo,
    .version = "0.6.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xa9fef7e1c22a71e4,
    .dependencies = .{
        // A commit on zio's `main` rather than a tag: `spawnInto` (zio#761)
        // and the fixes for zio#744 and zio#745 are in no release yet. Move
        // to the tag that carries them when there is one.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=main#0299e5771b8c042ca42077af0748771fca27d38e",
            .hash = "zio-0.18.0-xHbVVPtIKgBBABs3c3jDBGiEAQlZjJysiJg9ot-dIZ2e",
        },
        // The driver behind `nilo_sql`, and lazy on purpose: it brings four
        // transitive dependencies of its own (buffer, metrics, xsync, tls),
        // and a project that serves HTTP and never imports the SQL module
        // should not fetch, build or link any of them (ADR 036).
        //
        // **`.lazy = true` is half of that and the smaller half.** It stops
        // Zig fetching this package while reading the manifest; it does
        // nothing about `build.zig` asking for it, and `b.lazyDependency`
        // *asks* — it answers null on the pass that finds the package missing
        // and enqueues the download. So the calls sit behind `-Dsql`, which is
        // off for a dependent until they pass `.sql = true`. ADR 066 is where
        // that was found, a year after the sentence above was published.
        //
        // `nevindra/pg.zig` is lalinsky's `ec8cf27` plus two of karlseguin's
        // `master`: startup_parameters reach the server (`2907296`), and a
        // cached statement stops paying a second round trip (`2c7c6ca`,
        // `bench/result/sql.md` §16). Move back to lalinsky's once
        // lalinsky/pg.zig#13 is merged.
        .pg = .{
            .url = "git+https://github.com/nevindra/pg.zig#0a8dab418315048ee545a0096f4ac62cb97e9d30",
            .hash = "pg-0.0.0-Wp_7gVK8BgC_5-H41JsVCpQqanRobB3SiML9V7A2XJtm",
            .lazy = true,
        },
        // The other driver behind `nilo_sql`, and lazy for the same reason.
        // Unlike pg.zig it brings **no dependencies of its own** — it bundles
        // and statically links the SQLite amalgamation, which is what makes it
        // the whole of the C question rather than the start of it
        // (ADR 064). Three files and 47 KB of Zig over the top, which is also
        // the answer to "what if it stops": `sql/wire.zig` is a seam, and one
        // file gets rewritten rather than every call site.
        .zqlite = .{
            .url = "git+https://github.com/karlseguin/zqlite.zig#b519eea9b1a2b5fcad68af6d0629e717e8746684",
            .hash = "zqlite-0.0.1-RWLaY8M8nAB4m0tlSpT9A5PGUwX_JfWC5VlPjLe7lG2Q",
            .lazy = true,
        },
        // The TLS 1.3 server behind `-Dtls` (ADR 212), and lazy for the
        // reason the drivers are: a program that never asks fetches nothing.
        // Pure Zig on `std.crypto`, no C, and pinned to a commit rather than
        // a tag, because it has no tags. The commit, not the branch, is the
        // pin.
        //
        // **A fork's commit, for now**: upstream's `zig-0.16.x` plus two
        // commits. One signs with the key's CRT form, which takes an RSA-2048
        // handshake from 13.7 to 2.6 ms of server CPU; it is
        // ianic/tls.zig#59 (bench/result/http.md, "What an RSA certificate
        // costs a handshake"). The other adds the server's `offload` option,
        // which the Engine uses to sign on the blocking pool (ADR 217). Once
        // both are upstream, the pin goes back to it and the fork is not used
        // again.
        .tls = .{
            .url = "git+https://github.com/nevindra/tls.zig#73290ca7aa5a13c6c2131e5d35676109ac6a73cc",
            .hash = "tls-0.1.0-ER2e0kvdBgABZ6SYdVWmbLYIb-42yDaDpz9nIzA2OXTB",
            .lazy = true,
        },
        // Node's HTTP parser, as a second reading of RFC 9112 for
        // `zig build fuzz-llhttp` (ADR 231), and linked into nothing else.
        // C, so it waits behind `-Dllhttp` as well as `.lazy`. A release
        // tarball rather than the repository: the parser in `src/` is
        // generated, and only the release branch carries it.
        .llhttp = .{
            .url = "https://github.com/nodejs/llhttp/archive/refs/tags/release/v9.4.3.tar.gz",
            .hash = "N-V-__8AANkgBgCZosn_JabRa_Pm-AMJtzCRfMWzALMRadIE",
            .lazy = true,
        },
    },
    // One directory per module that ships (ADR 038), and this list is the
    // one place that has to remember they exist — held by a comptime check
    // in `build.zig`, because a dependent whose package is missing a
    // directory finds out at their own build rather than ours.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "core",
        "id",
        "config",
        "pw",
        "cache",
        "jwt",
        "fetch",
        "job",
        "http",
        "sql",
        "s3",
        "dev",
        "LICENSE",
        "README.md",
    },
}
